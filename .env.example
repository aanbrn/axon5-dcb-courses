# SPDX-License-Identifier: MIT
#
# Optional local environment of the course system. Copy this file to `.env` (untracked, git-ignored) to change
# anything below; Docker Compose reads `.env` from the repository root by itself. Without a `.env` every default
# applies and `docker compose up -d --wait` just works. Every line here is commented out on purpose: an active
# assignment in the committed template would silently apply to everyone who copies it.

# AxonIQ Platform token (optional).
#
# An Axon Server that is not registered with an AxonIQ Platform workspace stops itself about 12 hours after it
# starts, and every container restart opens a new 12-hour window. A token from an AxonIQ Platform workspace lifts the
# limit. Uncomment the line below and replace the placeholder to use one.
#
# NEVER set it to an empty value. An empty value counts as configured: Axon Server then fails to start its Platform
# connection and stays in the state "running" with dead HTTP and gRPC endpoints. Leave the line commented out or
# remove it to run without a token. CI uses no token.
# AXONIQ_PLATFORM_AUTHENTICATION=<environment-id>:<token>

# Development overrides (optional). Each default below is a development value, not a secret.
#
# Password of the PostgreSQL superuser `postgres`; the default is `postgres-dev`.
# POSTGRES_PASSWORD=
# Password of the login role `query_service`; the default is `query-service-dev`.
# QUERY_SERVICE_DB_PASSWORD=
# Password of the login role `automation_service`; the default is `automation-service-dev`.
# AUTOMATION_SERVICE_DB_PASSWORD=
# Host port of PostgreSQL on the loopback interface; the default is 5432. Set it when another PostgreSQL already
# holds 5432 on your machine.
# POSTGRES_PORT=
