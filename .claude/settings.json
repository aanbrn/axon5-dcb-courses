{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Edit(/.planning/config.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.mcp.json)",
      "Edit(/CODEOWNERS)",
      "Edit(/docs/CODEOWNERS)",
      "Edit(/governance/**)",
      "Edit(/mise.toml)",
      "Edit(/mise.lock)",
      "Edit(/.mise/locks/**)",
      "Edit(/.mise.toml)",
      "Edit(/mise.local.toml)",
      "Edit(/.mise.local.toml)",
      "Edit(/mise/**)",
      "Edit(/.mise/config.toml)",
      "Edit(/.mise/config.local.toml)",
      "Edit(/.mise/conf.d/**)",
      "Edit(/.config/mise.toml)",
      "Edit(/.config/mise.local.toml)",
      "Edit(/.config/mise/**)",
      "Edit(/.tool-versions)",
      "Edit(/.miserc.toml)",
      "Edit(/.miserc.local.toml)",
      "Edit(/.config/miserc.toml)",
      "Edit(/renovate.json)",
      "Edit(/renovate.jsonc)",
      "Edit(/renovate.json5)",
      "Edit(/.gitlab/renovate.json)",
      "Edit(/.gitlab/renovate.jsonc)",
      "Edit(/.gitlab/renovate.json5)",
      "Edit(/.renovaterc)",
      "Edit(/.renovaterc.json)",
      "Edit(/.renovaterc.jsonc)",
      "Edit(/.renovaterc.json5)",
      "Edit(/package.json)",
      "Edit(/.github/**)",
      "Edit(/scripts/apply-github-settings.sh)",
      "Edit(/scripts/governance/**)",
      "Edit(/build-logic/src/main/kotlin/courses.governance.gradle.kts)",
      "Edit(/build-logic/src/main/kotlin/courses.licences.gradle.kts)",
      "Edit(/build-logic/src/main/kotlin/io/github/aanbrn/courses/buildlogic/governance/**)",
      "Edit(/build.gradle.kts)",
      "Edit(/build.gradle)",
      "Edit(/settings.gradle.kts)",
      "Edit(/settings.gradle)",
      "Edit(/gradle.properties)",
      "Edit(/buildSrc/**)",
      "Edit(/build-logic/build.gradle.kts)",
      "Edit(/build-logic/build.gradle)",
      "Edit(/build-logic/settings.gradle.kts)",
      "Edit(/build-logic/settings.gradle)",
      "Edit(/build-logic/src/main/kotlin/courses.root.gradle.kts)",
      "Edit(/build-logic/src/main/kotlin/courses.settings.settings.gradle.kts)",
      "Edit(/config/detekt/**)",
      "Edit(/.editorconfig)",
      "Edit(/**/.editorconfig)",
      "Edit(/qodana.yaml)",
      "Edit(/scripts/qodana.sh)",
      "Edit(/gradlew)",
      "Edit(/gradle/wrapper/**)",
      "Edit(/gradle/gradle-daemon-jvm.properties)",
      "Bash(*config-set*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/governance/ask-governed-edit.sh"],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/governance/ask-governed-merge.sh"],
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "axoniq": {
      "source": {
        "source": "github",
        "repo": "AxonIQ/agent-skills",
        "ref": "59e7beb6bb487894aeb1294918463af1432bdece"
      }
    },
    "gradle-skills": {
      "source": {
        "source": "github",
        "repo": "gradle/gradle-skills",
        "ref": "00b7790139dff32063976f98334b2a2301b50a9d"
      }
    }
  },
  "enabledPlugins": {
    "axoniq-app-development@axoniq": true,
    "gradle-skills@gradle-skills": true
  }
}
