/.idea/

# Claude Code: track only project-owned files; GSD install and local settings stay untracked
/.claude/*
!/.claude/settings.json
!/.claude/CLAUDE.md
# D-39: the GSD spike wrap-up skill is tracked as a narrow exception
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/spike-findings-*/
# ADR-0014: the vendored dynamic-consistency-boundaries skill of AxonIQ/AxonFramework is a second narrow exception
!/.claude/skills/dynamic-consistency-boundaries/

# GSD state-contract snapshot: derived from ROADMAP.md/STATE.md and rewritten at every step boundary
/.planning/state.json

# mise: track only the sidecar lockfiles that mise.lock references by digest; anything else mise
# or a tool writes under .mise stays local
/.mise/*
!/.mise/locks/

# MCP tool output (Playwright MCP writes snapshots and logs here, relative to its working directory)
.playwright-mcp/

# Gradle and Kotlin state
.gradle/
build/
.kotlin/
out/

# Node and pnpm
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# IDE
*.iml
.vscode/*
!.vscode/extensions.json

# Environment and secrets
.env
.env.*
!.env.example

# Test and coverage artifacts
test-results/
playwright-report/
blob-report/
coverage/

# gradle-profiler output
profile-out/
gradle-user-home/

# Swift Package Manager cache tag that a tool run by the pre-commit hooks leaves in the working directory
/.build/

# OS files
.DS_Store
